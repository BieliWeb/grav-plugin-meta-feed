{# Default post layout. Override in your theme at templates/flex/post/object/default.html.twig #}
<article class="meta-feed__post meta-feed__post--{{ post.provider }}">
    {% if post.image_url %}
        <a class="meta-feed__media" href="{{ post.link }}" target="_blank" rel="noopener">
            <img src="{{ post.image_url }}" alt="" loading="lazy">
            {% if post.media_type == 'VIDEO' %}
                <span class="meta-feed__badge">▶</span>
            {% endif %}
        </a>
    {% endif %}

    {% if post.message %}
        <div class="meta-feed__body">{{ post.message|nl2br }}</div>
    {% endif %}

    <footer class="meta-feed__meta">
        <time datetime="{{ post.published_at }}">{{ post.published_at|date('d.m.Y') }}</time>
        <a href="{{ post.link }}" target="_blank" rel="noopener">{{ post.provider|capitalize }}</a>
    </footer>
</article>
