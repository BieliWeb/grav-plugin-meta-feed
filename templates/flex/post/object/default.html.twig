{# Default post layout. Override in your theme at templates/flex/post/object/default.html.twig #}
<article class="meta-feed__post">
    <a href="{{ post.link }}" target="_blank" rel="noopener noreferrer">
        {% if post.imageUrl %}
            <img src="{{ post.imageUrl }}" alt="" loading="lazy">
        {% endif %}
        {% if post.message %}
            <p>{{ post.message|nl2br }}</p>
        {% endif %}
        <time datetime="{{ post.published_at }}">{{ post.published_at|date('d.m.Y') }}</time>
    </a>
</article>
