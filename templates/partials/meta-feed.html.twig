{#
    Simple, unstyled social feed output.

    Include it anywhere in your templates:

        {% include 'partials/meta-feed.html.twig' %}
        {% include 'partials/meta-feed.html.twig' with { provider: 'instagram', limit: 6 } %}

    To customise it, copy this file to your theme and edit it there:

        your-theme/templates/partials/meta-feed.html.twig

    Available variables:
        provider  'instagram', 'facebook' or '' for both  (default: '')
        limit     maximum number of posts, 0 for all      (default: 12)
#}
{% set posts = meta_feed_posts(provider|default(''), limit|default(12)) %}

{% if posts %}
    <ul class="meta-feed">
        {% for post in posts %}
            <li class="meta-feed__item">
                <a href="{{ post.link }}" target="_blank" rel="noopener noreferrer">
                    {% if post.imageUrl %}
                        <img src="{{ post.imageUrl }}"
                             alt="{{ post.message|striptags|truncate(100, false, ' ', '')|e('html_attr') }}"
                             loading="lazy">
                    {% endif %}
                    {% if post.message %}
                        <p>{{ post.message|striptags|truncate(140, false, ' ', '…') }}</p>
                    {% endif %}
                    <time datetime="{{ post.published_at }}">{{ post.published_at|date('d.m.Y') }}</time>
                </a>
            </li>
        {% endfor %}
    </ul>
{% endif %}
